# Tier Zero — environment template
#
# Copy to .env and fill in. .env is gitignored and must STAY gitignored.
# NEVER put a real API key in this file — this one is committed.
#
# On a host (Render, PythonAnywhere) you do not use a .env file at all: you set
# these in the host's own environment settings. Same names, same values.

# ---------------------------------------------------------------- required in production
# Locks /maintainer and /maintainer/quality.
# If this is unset, those pages are OPEN TO EVERYONE.
TZ_MAINTAINER_PASSWORD=

# Signs the session cookie. Without it the maintainer login breaks across
# workers and restarts. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TZ_SECRET_KEY=

# Set to 1 once you are serving over HTTPS. Marks the session cookie Secure.
TZ_HTTPS=1

# ---------------------------------------------------------------- behaviour
TZ_RETRIEVER=bm25
TZ_ANSWERER=extractive
TZ_THRESHOLD=4.0
TZ_ASK_PER_MINUTE=12
TZ_ASK_PER_HOUR=120

# ---------------------------------------------------------------- optional: LLM answerer
# Only needed with TZ_ANSWERER=local. One adapter, four providers:
#
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai   gemini-3.6-flash
#   Groq        https://api.groq.com/openai/v1                            llama-3.3-70b-versatile
#   OpenRouter  https://openrouter.ai/api/v1                              meta-llama/llama-3.3-70b-instruct:free
#   Ollama      http://localhost:11434/v1                                 llama3.2:3b
#
TZ_LLM_BASE_URL=
TZ_LLM_MODEL=
TZ_LLM_API_KEY=
# Room for the model's thinking plus a short answer. Raise it if answers
# fall back with 'ran out of tokens'.
TZ_LLM_MAX_TOKENS=2048

# Only needed with TZ_ANSWERER=claude.
TZ_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
